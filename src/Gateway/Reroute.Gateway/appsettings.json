{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Oidc": {
    "Authority": "http://localhost:8081/realms/reroute",
    "ClientId": "reroute-bff",
    "ClientSecret": "dev-only-bff-secret",
    "Scopes": "openid profile email offline_access"
  },
  "ReverseProxy": {
    "Routes": {
      "claims": {
        "ClusterId": "claims",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/claims/{**rest}" }
      },
      "claims-ops": {
        "ClusterId": "claims",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/ops/claims/{**rest}" }
      },
      "disruptions": {
        "ClusterId": "disruption",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/flights/{**rest}" }
      },
      "disruptions-ops": {
        "ClusterId": "disruption",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/ops/disruptions/{**rest}" }
      },
      "copilot": {
        "ClusterId": "copilot",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "copilot",
        "Match": { "Path": "/api/copilot/{**rest}" }
      },
      "recommendations": {
        "ClusterId": "copilot",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/recommendations/{**rest}" }
      },
      "search": {
        "ClusterId": "search",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/search/{**rest}" }
      },
      "notifications-hub": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/hubs/{**rest}" }
      }
    },
    "Clusters": {
      "claims": { "Destinations": { "d1": { "Address": "http://localhost:5104" } } },
      "disruption": { "Destinations": { "d1": { "Address": "http://localhost:5102" } } },
      "copilot": { "Destinations": { "d1": { "Address": "http://localhost:5107" } } },
      "search": { "Destinations": { "d1": { "Address": "http://localhost:5106" } } },
      "notification": { "Destinations": { "d1": { "Address": "http://localhost:5108" } } }
    }
  }
}
