<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- CA1848 (LoggerMessage), CA1711, CA1716, CA2007 are noisy for app code; documented exceptions -->
    <NoWarn>$(NoWarn);CA1848;CA1711;CA1716;CA2007;CA1062;CA1515;CA1031;CA1873;CA1716;CA1720;CA1724;CA1032;CA1819;CA1859;CA1305;CA1307;CA1310;CA1309;CA2227;CA1002;CA1063;CA1816;CA1806;CA1508;CA2016;CA1056;CA1054;CA1034;CA1000;CA1812;CA1852;CA5394;CA1822;CA1866;CA1865;CA1847;CA1311;CA1304;CA1725;CA2201;CA1068</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
