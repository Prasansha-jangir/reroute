<!-- Personal project: only the public nuget.org feed. <clear/> ignores any machine/employer-level feeds. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
